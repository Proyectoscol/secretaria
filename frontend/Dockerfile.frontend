# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
# If package-lock.json was not committed, generate it before installing.
# `npm ci` requires a lockfile; `npm install` creates one if absent.
RUN if [ -f package-lock.json ]; then \
      npm ci --ignore-scripts; \
    else \
      echo "WARN: package-lock.json missing — running npm install (slower)" && \
      npm install --ignore-scripts; \
    fi

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma client
RUN npx prisma generate

# next.config.ts with TypeScript is not supported by Next.js 14 bundler.
# Prefer next.config.mjs; remove .ts variant if both exist.
RUN if [ -f next.config.mjs ] && [ -f next.config.ts ]; then \
      echo "INFO: both next.config.mjs and next.config.ts found — removing .ts" && \
      rm next.config.ts; \
    fi

# Build Next.js standalone output
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ── Stage 3: runner ────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
# Prisma native query engine is not traced by Next.js standalone output.
# Copy it explicitly so PrismaClient can load at runtime.
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
