# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://tudominio.com
NEXTAUTH_SECRET=genera-con-openssl-rand-base64-32

# ─── Backend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only — do NOT prefix with NEXT_PUBLIC_ (must not be embedded in browser bundle)
LIBRARIAN_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Microsoft App 1 — Autenticación ──────────────────────────────────────────
MICROSOFT_AUTH_CLIENT_ID=
MICROSOFT_AUTH_CLIENT_SECRET=
MICROSOFT_AUTH_TENANT_ID=common
MICROSOFT_AUTH_SCOPES="openid profile email User.Read"

# ─── Microsoft App 2 — Permisos de plataforma ─────────────────────────────────
MICROSOFT_PLATFORM_CLIENT_ID=
MICROSOFT_PLATFORM_CLIENT_SECRET=
MICROSOFT_PLATFORM_TENANT_ID=common
MICROSOFT_PLATFORM_SCOPES="offline_access Files.Read.All Mail.Read Calendars.Read"
MICROSOFT_TOKEN_ENCRYPTION_KEY=genera-con-openssl-rand-base64-32

# ─── Restricción de dominio ───────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=@proyectoscall.com

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://openclaw:openclaw@localhost:5432/openclaw

# ─── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_ONEDRIVE=true
NEXT_PUBLIC_FEATURE_MAIL=false
NEXT_PUBLIC_FEATURE_CALENDAR=false

# ─── Sistema de correo — Secretario IA ───────────────────────────────────────
# Dominio del servidor de correo
MAIL_DOMAIN=empresa.com

# Buzón principal del Secretario IA
MAIL_SECRETARIO_ADDRESS=secretaria@empresa.com
MAIL_SECRETARIO_PASSWORD=contraseña-segura-del-buzon
MAIL_SECRETARIO_DISPLAY_NAME=Secretaria IA

# Modo de recepción: 'imap' (polling) o 'pipe' (Postfix directo)
MAIL_RECEIVE_MODE=imap
MAIL_POLL_INTERVAL_SECONDS=30

# Límite diario de correos salientes (protección anti-spam)
MAIL_MAX_DAILY_OUTBOUND=500

# Horario de reportes
MAIL_REPORT_TIMEZONE=America/Bogota
MAIL_REPORT_RECIPIENTS_DAILY=gerente@empresa.com
MAIL_REPORT_RECIPIENTS_WEEKLY=gerente@empresa.com,director@empresa.com

# Conexión interna a Postfix y Dovecot (no cambiar si usas Docker Compose)
MAIL_SMTP_HOST=postfix
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=dovecot
MAIL_IMAP_PORT=993

# ─── LLM (OpenRouter) ─────────────────────────────────────────────────────────
# Server-side only — never prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Model overrides (defaults shown — change only if needed)
# LLM_MODEL_HEAVY=anthropic/claude-sonnet-4-5
# LLM_MODEL_LIGHT=openai/gpt-4o-mini
# LLM_TIMEOUT_SECONDS=60

# ─── Langfuse (self-hosted LLM observability) ─────────────────────────────────
# Access the Langfuse UI at http://localhost:3001 (Docker Compose maps port 3001)
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
# These are set in docker-compose.kos.yml — match them here:
# LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
# LANGFUSE_SALT=change-me-in-production
